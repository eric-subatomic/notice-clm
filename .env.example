# Notice production configuration template. This file contains no credentials.
# Copy values into the deployment configuration and replace every customer.invalid
# or replace-* placeholder. Put secrets only in the deployment secret manager.

NOTICE_APP_MODE=production
NOTICE_DEPLOYMENT_MODEL=hosted
NOTICE_PUBLIC_BASE_URL=https://notice.customer.invalid
# 3-63 lowercase letters, digits, or hyphens; first character alphanumeric.
NOTICE_WORKSPACE_ID=replace-with-permanent-workspace-id
NOTICE_WORKSPACE_NAME=Replace with customer-approved workspace name
NOTICE_BOOTSTRAP_ENABLED=true
NOTICE_BOOTSTRAP_ADMIN_EMAILS=first-admin@customer.invalid,second-admin@customer.invalid

# Recommended production SSO. The team domain and application AUD are not
# secrets; Notice uses them to verify the signed Cf-Access-Jwt-Assertion.
NOTICE_AUTH_MODE=cloudflare-access
NOTICE_ACCESS_TEAM_DOMAIN=https://replace-with-team.cloudflareaccess.invalid
NOTICE_ACCESS_AUDIENCE=replace-with-64-character-access-application-aud

# Compatibility mode only: set NOTICE_AUTH_MODE=trusted-headers and this flag
# to true after a separately reviewed edge blocks direct origin access, strips
# caller-supplied x-notice-identity-* headers, and injects verified values.
NOTICE_TRUST_IDENTITY_HEADERS=false

# E-signature: DocuSeal is the repository-provided provider adapter. The
# template supplies the customer-approved signature page/fields. Notice reads
# and SHA-256-verifies immutable text/Markdown bytes, then decodes and escapes
# that working text into a one-off HTML document. The UI accepts 1-10 signers;
# the customer authorizes their roles, addresses, and provider delivery policy.
# Leave CONFIGURED=false and the entitlement attestation false until the
# checks in docs/DOCUSEAL.md and the authenticated live diagnostic succeed.
NOTICE_ESIGN_ENABLED=true
NOTICE_ESIGN_PROVIDER=docuseal
NOTICE_ESIGN_CONFIGURED=false
NOTICE_DOCUSEAL_DEPLOYMENT=cloud-global
NOTICE_DOCUSEAL_API_BASE_URL=https://api.docuseal.com
NOTICE_DOCUSEAL_VALIDATED_RELEASE=3.2.1
NOTICE_DOCUSEAL_API_CLIENT_CONTRACT=1.0.24
NOTICE_DOCUSEAL_TEMPLATE_ID=replace-with-positive-template-id
NOTICE_DOCUSEAL_HTML_SUBMISSIONS_ENTITLED=false
NOTICE_DOCUSEAL_EXPIRATION_HOURS=168
NOTICE_DOCUSEAL_EMAIL_2FA_REQUIRED=true
NOTICE_DOCUSEAL_MCP_ENABLED=false
# Required managed secret: NOTICE_DOCUSEAL_API_TOKEN
# Required managed secret: NOTICE_DOCUSEAL_WEBHOOK_SECRET must be the whsec_
# value from the webhook HMAC tab, not DocuSeal's arbitrary Secret header.
# Self-hosted only when MCP is enabled:
# NOTICE_DOCUSEAL_MCP_PROTOCOL_VERSION=2025-11-25
# NOTICE_DOCUSEAL_MCP_SERVER_VERSION=3.2.1
# Required separate managed secret when enabled: NOTICE_DOCUSEAL_MCP_TOKEN

# Document scanning: the gateway receives an HMAC-authenticated scan request.
NOTICE_SCAN_ENABLED=true
NOTICE_SCAN_PROVIDER=scan-gateway
NOTICE_SCAN_CONFIGURED=false
NOTICE_SCAN_GATEWAY_URL=https://scanner.customer.invalid/v1/scan
NOTICE_SCAN_OCR_ENABLED=false
# When enabled, use bounded non-secret identifiers resolved only by the customer-hosted scanner gateway:
# NOTICE_SCAN_OCR_MODEL_ID=customer-vision-v1
# NOTICE_SCAN_OCR_PROFILE_ID=contracts-en-v1
# Required managed secret (at least 32 characters): NOTICE_SCAN_GATEWAY_SECRET

# Notifications and lifecycle events use the signed canonical delivery gateway.
NOTICE_MAIL_ENABLED=true
NOTICE_MAIL_PROVIDER=delivery-gateway
NOTICE_MAIL_CONFIGURED=false
# Set true only after the separate counterparty-message acceptance proves the
# exact portal-link rendering, recipient policy, and optional Reply-To behavior.
NOTICE_NEGOTIATION_MAIL_ACCEPTED=false
NOTICE_DELIVERY_GATEWAY_URL=https://delivery.customer.invalid/v1/events
# Required managed secret (at least 32 characters): NOTICE_DELIVERY_GATEWAY_SECRET

# Counterparty exchange. The scoped portal provides the safe default for every
# negotiation round. Its random link expires after 1-336 hours and can be
# rotated or closed without changing the agreement URL.
NOTICE_COUNTERPARTY_PORTAL_ENABLED=true
NOTICE_COUNTERPARTY_PORTAL_TTL_HOURS=72

# Optional inbound email capture is off by default because the repository does
# not bundle a mail-receiving provider. To enable it, choose inbound-gateway,
# set a real dedicated NOTICE_INBOUND_EMAIL_DOMAIN, provision the managed
# secret below, and leave CONFIGURED=false until the documented raw-body HMAC
# checks and a harmless attachment round trip pass.
NOTICE_EMAIL_CAPTURE_ENABLED=false
NOTICE_EMAIL_CAPTURE_PROVIDER=none
NOTICE_EMAIL_CAPTURE_CONFIGURED=false
# NOTICE_INBOUND_EMAIL_DOMAIN=redlines.customer.invalid
# Required managed secret when enabled (at least 32 characters and at most 4096 UTF-8 bytes): NOTICE_INBOUND_EMAIL_SECRET

# CRM is optional. The included separately deployed CRM gateway supports
# HubSpot, Salesforce, and a signed custom webhook while keeping OAuth tokens
# and field mappings out of the browser and primary Notice Worker.
NOTICE_CRM_ENABLED=false
# When enabled, choose exactly one: hubspot, salesforce, or custom.
NOTICE_CRM_PROVIDER=none
# Must exactly match the included CRM gateway deployment when CRM is enabled.
NOTICE_CRM_MAPPING_VERSION=v1
NOTICE_CRM_CONFIGURED=false
NOTICE_CRM_GATEWAY_URL=https://notice-crm.customer.invalid/v1/events
# Required when CRM is enabled (at least 32 characters): NOTICE_CRM_GATEWAY_SECRET

# Retention soft-deletes eligible records at expiry. Hard purge begins only
# after this additional grace period; accepted range is 7-365 days.
NOTICE_RETENTION_PURGE_GRACE_DAYS=30

# Required managed secret for all three scheduled job routes (at least 32 characters): NOTICE_JOB_RUNNER_SECRET
NOTICE_OUTBOX_CRON=*/5 * * * *
NOTICE_RETENTION_CRON=15 2 * * *
# Required managed secret for production audit/offboarding exports (at least 32 characters): NOTICE_AUDIT_SIGNING_KEY
